rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 교사(관리자) 여부 확인 함수:
    // 1) users 컬렉션에 role이 'teacher'로 등록되어 있거나
    // 2) 연수/테스트 관리자 계정(yunyoung.so@gmail.com)인 경우
    function isTeacher() {
      return request.auth != null && (
        request.auth.token.email == 'yunyoung.so@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // users 컬렉션 규칙
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isTeacher() || (request.auth != null && request.auth.uid == userId);
    }

    // memos 컬렉션 규칙
    match /memos/{memoId} {
      // 누구나 읽기 가능
      allow read: if true;

      // 생성: 로그인한 사용자
      // 교사이거나 본인 uid로만 생성 가능 (텍스트 5자 이상 50자 이하)
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && (isTeacher() || request.resource.data.uid == request.auth.uid);

      // 삭제: 교사만 가능 (학생은 다른 사람 것은 물론 삭제 권한 없음 - 생성만 부여)
      allow delete: if isTeacher();

      // 업데이트: 교사만 aiComment 필드 등을 업데이트할 수 있도록 허용
      allow update: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
